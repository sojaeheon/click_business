# 베이스 이미지
FROM python:3.11-slim

# 작업 디렉토리 설정
WORKDIR /app

# requirements.txt 복사 및 설치
COPY ../kafka/configs/market_consumer_requirements.txt .
RUN pip install --no-cache-dir -r market_consumer_requirements.txt

# 소스 코드 전체 복사
COPY ../kafka/consumers /app/consumers

# start.sh 복사 및 실행 권한 부여
COPY ../kafka/scripts/start.sh /app/start.sh
RUN chmod +x /app/start.sh

# 컨테이너 시작 시 start.sh 실행
CMD ["./start.sh"]